# Credenciales del ORIGEN (MS SQL Server con un restore de Geus_ISP_DB) y del
# DESTINO (PostgreSQL 18 con locale ICU). Copie a .env y ajuste. NO commitear .env.
MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_DB=Geus_ISP_DB
MSSQL_USER=sa
MSSQL_PASS=change_me

PG_HOST=localhost
PG_PORT=5432
PG_DB=Geus_ISP_DB
PG_USER=postgres
PG_PASS=change_me

# --- Driver ODBC para pyodbc (solo el ETL / la validacion leen MSSQL) ---
# Ajuste si su SO tiene el 17 en vez del 18, o si necesita otros parametros.
# MSSQL_ODBC_DRIVER=ODBC Driver 18 for SQL Server
# MSSQL_ODBC_EXTRA=TrustServerCertificate=yes;Encrypt=no

# --- Opcionales ---
# Locale ICU al crear la base con --fresh (default es-ES):
# PG_ICU_LOCALE=es-ES
# Base de administracion para el DROP/CREATE de --fresh (default postgres):
# PG_ADMIN_DB=postgres
# Ubicacion del DDL 00..03 (default: ../postgres/geus_isp_db):
# DDL_DIR=/ruta/al/ddl
